# Set locally; never commit agents/.env or paste secrets into chat.
# Use the same randomly generated service secret in the web backend.
AGENT_SERVICE_KEY=

# Leave blank until billing and the initial test allowance are confirmed in chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# Keep disabled until billing and the test budget are confirmed in chat.
NIGHTWATCH_LIVE_CALLS_ENABLED=false

# Optional public-indicator reports; separate opt-in, disabled by default.
# VirusTotal says queried IPs/domains may be scanned and shared with its community.
# Never enable for sensitive indicators. No file uploads or URL submissions.
NIGHTWATCH_INTEL_ENABLED=false
VIRUSTOTAL_API_KEY=
