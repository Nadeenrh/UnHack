# Copy to .env.local and fill in real values. Never commit the real file.

# MySQL (docker-compose-dev.yml)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=nightwatch


# Response executor: "simulate" (changes nothing, says so) or "wazuh"
EXECUTOR_MODE=simulate
# WAZUH_API_URL=https://192.168.8.5:55000
# WAZUH_API_USER=wazuh-wui
# WAZUH_API_PASSWORD=change-me
# WAZUH_TLS_INSECURE=true

# Python agent service (leave unset until it exists)
# AGENT_SERVICE_URL=http://localhost:8000
# AGENT_SERVICE_KEY=change-me

# Address the Wazuh manager uses to reach this server. Shown in the setup snippets.
# Leave unset to use whatever address the browser used (fine unless that's localhost).
# NIGHTWATCH_PUBLIC_URL=http://192.168.8.50:3000

# Wazuh dashboard, for "Open in Wazuh" links (Nightwatch staff only; clients never see them)
# WAZUH_DASHBOARD_URL=https://192.168.8.5
# Optional path for one machine's events. {agent_id} and {agent_name} are filled in.
# WAZUH_DASHBOARD_LINK=/app/threat-hunting#/overview/?tab=general&tabView=events&agentId={agent_id}

# How clients reach your team (shown on their Settings page). Defaults are placeholders.
# NIGHTWATCH_SUPPORT_EMAIL=team@nightwatch.example
# NIGHTWATCH_SUPPORT_PHONE=+1 (000) 000-0000
# NIGHTWATCH_SUPPORT_HOURS=Monitored 24/7

APP_PORT=3000
